# Copy to .env and adjust. Every variable here is validated at boot by
# src/config/env.ts -- the process exits with a readable message if one is
# missing or malformed.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=4000

# Mongo connection string.
#   docker compose up -d  ->  use the value below as-is
#   Atlas                 ->  mongodb+srv://<user>:<pass>@<cluster>/g-dash?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/g-dash

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:3000

# morgan log format: dev | combined | common | short | tiny
LOG_FORMAT=dev

# --- Auth -------------------------------------------------------------------

# Signs the session JWTs. Minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# bcrypt cost factor (10-15). Higher is slower to crack and slower to log in.
BCRYPT_ROUNDS=12

# Only for cross-subdomain cookies, e.g. ".example.com". Leave unset locally.
# COOKIE_DOMAIN=

# --- OTP --------------------------------------------------------------------

OTP_LENGTH=5
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5

# Rate limit on POST /api/customer/auth/request-otp, keyed by mobile number.
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW_MINUTES=10

# How long a verified 'register' code stays usable as proof for
# POST /api/admin/customers -- the staff member's window to type the customer's
# name after the code is confirmed. Verifying a register code extends that
# record's TTL to this, so the proof outlives the 2-minute code.
REGISTRATION_WINDOW_MINUTES=15

# SMS gateway: console | kavenegar
#
# "console" prints the message instead of sending it and refuses to start in
# production. Add further providers in src/services/sms.ts.
SMS_PROVIDER=console

# Kavenegar credentials. Required once SMS_PROVIDER=kavenegar -- the process
# refuses to boot without the key rather than failing on the first login.
KAVENEGAR_API_KEY=

# Sending line, e.g. 100020003. Used for ordinary messages such as the invoice
# link. One-time codes do NOT use it: Iranian gateways will not carry an OTP on
# a normal line, so those go through an approved template on verify/lookup,
# which uses the line configured on the template itself. Register a template
# named "otp" whose first token is the code.
KAVENEGAR_SENDER=

# --- Invoices ---------------------------------------------------------------

# Public origin of this API. Used to build the absolute invoice URL sent by
# SMS, so it must be reachable from a customer's phone -- localhost is fine
# locally and wrong everywhere else.
PUBLIC_API_URL=http://localhost:4000

# Where generated PDFs are written. Relative paths resolve to the api root.
INVOICE_STORAGE_DIR=uploads/invoices

# Chrome/Chromium used to render PDFs. We use puppeteer-core, which drives an
# already-installed browser rather than downloading one -- Google's browser CDN
# returns 403 from some regions, which makes the bundled-Chromium install fail.
# Leave unset to auto-detect the usual locations; set it explicitly in Docker
# (e.g. /usr/bin/chromium after `apk add chromium`).
# CHROME_EXECUTABLE_PATH=

# --- Seeding ----------------------------------------------------------------

# Read only by `pnpm --filter api seed:admin`. Set them, run the seed, then
# remove them -- the running server has no reason to hold an admin password.
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=
