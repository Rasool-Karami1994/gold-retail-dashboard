# Copy to .env and adjust. Every variable here is validated at boot by
# src/config/env.ts -- the process exits with a readable message if one is
# missing or malformed.
#
# ---------------------------------------------------------------------------
# DEPLOYING THE API AND THE WEB APP TO DIFFERENT DOMAINS
#
# The defaults below assume both apps share an origin (localhost, or the Docker
# stack). Splitting them across Render and Vercel changes four things, and
# three of them fail silently if you get them wrong:
#
#   NODE_ENV=production      adds Secure to the session cookie, and hides stack
#                            traces. SameSite stays Lax: the frontend proxies
#                            /api/* from its own origin, so requests arrive
#                            same-site even though the two apps are on
#                            different hosts. See DEPLOY.md section 6.
#   ALLOWED_ORIGIN           the deployed frontend's exact origin. A wrong
#                            value produces NO server-side error: the request
#                            succeeds, the browser discards the response.
#   PUBLIC_API_URL           this API's own public origin. It is the invoice
#                            link customers receive by SMS, so it must resolve
#                            from a phone on mobile data.
#   APP_BASE_URL             the frontend's public origin.
#
# READ THE COOKIE NOTE UNDER ALLOWED_ORIGIN BEFORE YOU DEPLOY. Cross-domain
# sessions have a constraint that CORS alone does not solve.
#
# DEPLOY.md walks through the rest.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the API listens on. Render injects its own PORT; leave this unset there.
PORT=4000

# Mongo connection string. MONGODB_URI is accepted as an alias, since that is
# what docker-compose.yml sets and what earlier versions of this file used.
#   docker compose up -d  ->  use the value below as-is
#   Atlas                 ->  mongodb+srv://<user>:<pass>@<cluster>/g-dash?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/g-dash

# ---------------------------------------------------------------------------
# Origins allowed to call this API, comma-separated. CORS_ORIGIN is accepted as
# an alias. Required in production. No trailing slash -- an origin is scheme +
# host + port and nothing else.
#
#   ALLOWED_ORIGIN=https://g-dash.vercel.app
#
# Vercel gives every branch its own hostname, so a preview deployment is a
# different origin and needs listing too:
#
#   ALLOWED_ORIGIN=https://g-dash.vercel.app,https://g-dash-git-dev-you.vercel.app
#
# NOTE: CORS IS MOSTLY NOT LOAD-BEARING IN THE DEFAULT DEPLOYMENT.
#
# The frontend proxies /api/* from its own origin (API_PROXY_TARGET in
# apps/web), so requests reach this API from Vercel's server with no Origin
# header and the allowlist is never consulted. It still governs anything that
# calls this API directly, so it is worth setting correctly regardless.
#
# The proxy exists because of a cookie constraint CORS cannot solve: the browser
# files a cookie under the host that set it, so a frontend on another domain
# never sees the session cookie, and apps/web/src/middleware.ts -- which reads
# it directly to decide which page to show -- would bounce every signed-in
# visitor back to the login page in a loop.
#
# LEAVE COOKIE_DOMAIN UNSET when using the proxy. The cookie has to be scoped to
# the frontend's origin, which is what happens naturally with no Domain
# attribute. Setting it scopes the cookie to a host the browser is not on, and
# the browser drops it.
#
# The alternative, which removes the proxy hop, needs a domain you own:
#
#   api.example.com  (Render)    COOKIE_DOMAIN=.example.com
#   app.example.com  (Vercel)    ALLOWED_ORIGIN=https://app.example.com
#
# DEPLOY.md section 6 covers both, and when to switch.
# ---------------------------------------------------------------------------
ALLOWED_ORIGIN=http://localhost:3000

# Public origin of the FRONTEND, e.g. https://app.example.com. Nothing reads it
# yet; it is here so anything building a link back into the web app has one
# place to read. Usually identical to the single value in ALLOWED_ORIGIN.
APP_BASE_URL=http://localhost:3000

# morgan log format: dev | combined | common | short | tiny
LOG_FORMAT=dev

# --- Auth -------------------------------------------------------------------

# Signs the session JWTs. Minimum 32 characters. Must be byte-identical to the
# web app's JWT_SECRET -- its middleware verifies this API's cookie locally.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# bcrypt cost factor (10-15). Higher is slower to crack and slower to log in.
BCRYPT_ROUNDS=12

# Shares the session cookie across subdomains of one registrable domain, e.g.
# ".example.com" so that api.example.com and app.example.com both see it. This
# is what makes the web middleware work on a split deployment -- see the note
# under ALLOWED_ORIGIN. Leave unset locally and on *.vercel.app.
# COOKIE_DOMAIN=

# --- OTP --------------------------------------------------------------------

OTP_LENGTH=5
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5

# Rate limit on POST /api/customer/auth/request-otp, keyed by mobile number.
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW_MINUTES=10

# How long a verified 'register' code stays usable as proof for
# POST /api/admin/customers -- the staff member's window to type the customer's
# name after the code is confirmed. Verifying a register code extends that
# record's TTL to this, so the proof outlives the 2-minute code.
REGISTRATION_WINDOW_MINUTES=15

# SMS gateway: console | kavenegar
#
# "console" (alias: "mock") hands the message text back instead of sending it,
# and REFUSES TO BOOT when NODE_ENV=production, because it would put one-time
# codes in API responses. Any production deployment needs `kavenegar`.
#
# Leaving this UNSET is not a safe default in production: with no Kavenegar key
# present the provider resolves to the mock anyway, so the API exits at boot
# rather than starting and failing every customer login later.
SMS_PROVIDER=console

# Kavenegar credentials. Required once SMS_PROVIDER=kavenegar -- the process
# refuses to boot without the key rather than failing on the first login.
KAVENEGAR_API_KEY=

# Sending line, e.g. 100020003. Used for ordinary messages such as the invoice
# link. One-time codes do NOT use it: Iranian gateways will not carry an OTP on
# a normal line, so those go through an approved template on verify/lookup,
# which uses the line configured on the template itself. Register a template
# named "otp" whose first token is the code.
KAVENEGAR_SENDER=

# Run the MOCK gateway in production on purpose. Leave unset unless you mean it.
#
# !! THIS TURNS OFF CUSTOMER AUTHENTICATION. !!
#
# The mock sends nothing and returns the one-time code in the API response,
# which the sign-in form then displays -- so anyone who knows a customer's
# mobile number can request a code, read it off their own screen, and sign in as
# that customer.
#
# It exists for the window before Kavenegar approves the `otp` template, when
# the alternative is not shipping the demo at all. The API prints a boxed
# warning on every boot and the admin shell shows a red banner on every page,
# because this is exactly the setting people forget they turned on.
#
# Unset it the moment KAVENEGAR_API_KEY arrives. See DEPLOY.md section 8.
# ALLOW_MOCK_SMS_IN_PRODUCTION=true

# --- Invoices ---------------------------------------------------------------

# Public origin of this API. Used to build the absolute invoice URL sent by
# SMS, so it must be reachable from a customer's PHONE -- localhost is fine
# locally and wrong everywhere else.
#   Render -> https://g-dash-api.onrender.com
PUBLIC_API_URL=http://localhost:4000

# Chrome/Chromium used to render PDFs. We use puppeteer-core, which drives an
# already-installed browser rather than downloading one -- Google's browser CDN
# returns 403 from some regions, which makes the bundled-Chromium install fail.
#
# Leave unset to auto-detect. findChrome() in services/invoice.ts tries, in
# order: this variable, the older CHROME_EXECUTABLE_PATH, a Chrome that
# `npx puppeteer browsers install chrome` left in PUPPETEER_CACHE_DIR, then the
# usual system install locations. An explicit value that does not exist is a
# hard error rather than a silent fall-through to the probe.
#
#   local dev   unset is fine if you have Chrome or Edge installed
#   Docker      the image sets /usr/bin/chromium after `apk add chromium`
#   Render      set it explicitly. Chromium is not on the base image, so either
#               add the Chrome buildpack (which lands at
#               /opt/render/project/.render/chrome/opt/google/chrome/chrome) or
#               install it during the build:
#                 PUPPETEER_CACHE_DIR=/opt/render/project/src/.puppeteer
#                 npx puppeteer browsers install chrome
#               The cache MUST sit inside the project directory -- anything
#               outside it is discarded before the service starts.
# PUPPETEER_EXECUTABLE_PATH=
# PUPPETEER_CACHE_DIR=

# Adds --single-process to the Chromium launch args. Leave it off.
#
# It is the largest memory saving available and it breaks PDF rendering
# outright: Page.printToPDF needs a compositor process that single-process mode
# does not provide, so every invoice fails with "Target closed". Verified on
# Chromium 149. Exposed only so the result can be reproduced elsewhere.
# PUPPETEER_SINGLE_PROCESS=false

# --- Cloudinary -------------------------------------------------------------
#
# THE ONLY STORAGE FOR RENDERED INVOICES. There is no local-disk path: Render's
# filesystem is ephemeral, so a PDF written there vanishes on the next deploy
# while `invoicePdfUrl` goes on pointing at it. services/invoice.ts uploads the
# buffer as a `raw` resource and stores the returned secure_url.
#
# ALL THREE ARE REQUIRED IN PRODUCTION -- the process refuses to boot without
# them, rather than recording sales whose invoices silently never appear.
# Outside production set all three or none; with none, rendering fails and the
# app degrades the way it already does for a failed render (the sale is saved,
# `invoicePdfUrl` stays null, and the detail screen offers a retry). The free
# tier is enough for development.
#
# A NOTE ON THE URL. Cloudinary delivery URLs for `raw` uploads are public, and
# that is deliberate: the customer opens the link from an SMS with no account,
# exactly as before. The protection is the same as it was on disk -- the
# public_id carries 128 bits of entropy, so the URL is the credential. What is
# NOT the same: these are served by Cloudinary's CDN, so the old `no-store` and
# `noindex` headers are gone and a leaked link can be cached or crawled. If
# that matters, switch the upload to `type: "authenticated"` and hand out
# signed, expiring URLs instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Seeding ----------------------------------------------------------------

# Read only by `pnpm --filter api seed:admin`. Set them, run the seed, then
# remove them -- the running server has no reason to hold an admin password.
# Minimum 12 characters.
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=
