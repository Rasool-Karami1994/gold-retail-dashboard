{
  "name": "g-dash",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"pnpm:dev:web\" \"pnpm:dev:api\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter web build && pnpm --filter api build",
    "start": "concurrently -n web,api -c cyan,magenta \"pnpm --filter web start\" \"pnpm --filter api start\"",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter web lint",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose stop mongo",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:seed": "docker compose exec api pnpm --filter api seed:admin"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
