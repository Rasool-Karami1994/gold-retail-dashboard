# Configuration for the Docker Compose stack. Copy to .env before the first
# `docker compose up`:
#
#   cp .env.example .env
#
# THIS FILE IS ONLY FOR CONTAINERS. Running the apps on the host with
# `pnpm dev` reads apps/api/.env and apps/web/.env.local instead; the three do
# not talk to each other. See README.md > Running the whole stack in Docker.
#
# One file feeds both containers on purpose -- JWT_SECRET has to be identical
# in the API and the web app, and two files is how that drifts.
#
# Values that depend on the container network (MONGODB_URI, CORS_ORIGIN,
# PUBLIC_API_URL, NEXT_PUBLIC_API_URL) are set in docker-compose.yml, not here.
# `environment:` beats `env_file:`, so a copy added below would be ignored
# without complaint.

# --- Ports on the HOST ------------------------------------------------------
# Container-internal ports are fixed (3000, 4100, 27017); these only decide
# what they are published as. 4100 rather than the 4000 in
# apps/api/.env.example because another project on this machine holds 4000.

WEB_PORT=3000
API_PORT=4100
MONGO_PORT=27017

# --- Auth -------------------------------------------------------------------
# Shared by both containers, and it must be the SAME value in each -- the web
# middleware verifies the API's cookie locally instead of calling /me. A
# mismatch produces no error: it just rejects every session and bounces users
# back to the login page in a loop. One file for both is what prevents that.
#
# Minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Read at run time by both containers, so a change here needs a restart, not a
# rebuild. (The NEXT_PUBLIC_* values are the opposite -- they are compiled into
# the browser bundle, which is why they live in docker-compose.yml under
# `build.args` and changing them means `--build`.)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- OTP --------------------------------------------------------------------

OTP_LENGTH=5
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW_MINUTES=10
REGISTRATION_WINDOW_MINUTES=15

# --- SMS --------------------------------------------------------------------
# console | kavenegar. "console" hands the message text back instead of sending
# it, which is how you read OTP codes locally:
#
#   docker compose logs -f api
#
# ONLY VALID IN THE DEV PROFILE, which is the default. The production images run
# NODE_ENV=production, and the mock provider refuses to load there because it
# would put one-time codes in API responses. It does not fail at boot -- it
# fails on the first OTP with a 502 and "Could not send the verification code",
# and the real reason is only in the API log. So
# `docker compose -f docker-compose.yml up` needs real Kavenegar credentials
# below, or no customer can be registered or signed in.
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# --- Logging ----------------------------------------------------------------
# dev | combined | common | short | tiny
LOG_FORMAT=dev

# --- Seeding ----------------------------------------------------------------
# Read only by the one-off seed command in the README, never by the running
# server. Set them, seed the admin, then blank them out.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
