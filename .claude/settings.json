{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/scripts/auto-commit.sh",
            "timeout": 30,
            "statusMessage": "Auto-committing changes"
          }
        ]
      }
    ]
  }
}
